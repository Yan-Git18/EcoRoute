rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function stored(path) {
      return exists(path) ? get(path).data : {};
    }

    function afterWrite(path) {
      return existsAfter(path) ? getAfter(path).data : {};
    }

    function activeRole(uid, roles) {
      let account = stored(/databases/$(database)/documents/users/$(uid));
      return account.size() > 0
        && account.get('role', 'citizen') in roles
        && account.get('isActive', true) == true;
    }

    function citizenOwnsDocument(uid) {
      return request.auth != null && request.auth.uid == uid
        && activeRole(uid, ['citizen', 'ciudadano']);
    }

    function isAdmin() {
      return request.auth != null && activeRole(request.auth.uid, ['admin', 'administrador']);
    }

    function isStaff() {
      return request.auth != null && activeRole(request.auth.uid, ['staff', 'personal']);
    }

    function isCitizen() {
      return request.auth != null && activeRole(request.auth.uid, ['citizen', 'ciudadano']);
    }

    function isCrewMember(teamId) {
      let profile = stored(/databases/$(database)/documents/users/$(request.auth.uid));
      return teamId is string && teamId.size() > 0 && teamId == profile.get('teamId', null);
    }

    function crewLeaderId(team) {
      let members = team.get('memberIds', []);
      return team.get('leaderId', members.size() > 0 ? members[0] : null);
    }

    function isCrewLeader(teamId) {
      return isCrewMember(teamId)
        && crewLeaderId(stored(/databases/$(database)/documents/crews/$(teamId))) == request.auth.uid;
    }

    function canStartReport(report) {
      let teamId = report.get('assignedToTeamId', null);
      let assignee = report.get('assignedStaffId', null);
      return teamId in [null, '']
        ? (assignee == request.auth.uid
          || (assignee == null && request.auth.uid in report.get('assignedStaffIds', [])))
        : isCrewLeader(teamId);
    }

    function crewExists(teamId) {
      return teamId is string && teamId.size() > 0
        && existsAfter(/databases/$(database)/documents/crews/$(teamId));
    }

    function canReadReport(report) {
      return isAdmin() || (isCitizen() && report.citizenId == request.auth.uid) || (isStaff() && (
        (report.status in ['assigned', 'asignado', 'in_progress', 'en proceso', 'resolved', 'resuelto']
          && (report.get('assignedStaffId', null) == request.auth.uid
            || isCrewMember(report.get('assignedToTeamId', null))))
        || (report.status in ['assigned', 'asignado']
          && request.auth.uid in report.get('assignedStaffIds', []))
      ));
    }

    function canReadReportChild(reportId) {
      let report = stored(/databases/$(database)/documents/reports/$(reportId));
      return report.size() > 0 && canReadReport(report);
    }

    function status(value) {
      return value == 'asignado' ? 'assigned'
        : value == 'en proceso' ? 'in_progress'
        : value == 'resuelto' ? 'resolved'
        : value == 'pendiente' ? 'pending'
        : value == 'cancelado' ? 'cancelled'
        : value;
    }

    function publicReportPath(reportId) {
      return /databases/$(database)/documents/communityReports/$(reportId);
    }

    function reportPath(reportId) {
      return /databases/$(database)/documents/reports/$(reportId);
    }

    function publicReportMatches(report, publicReport) {
      let fields = [
        'reportNumber', 'categoryId', 'categoryName', 'categoryIcon', 'description',
        'priority', 'status', 'latitude', 'longitude', 'address', 'createdAt',
        'updatedAt', 'imagePaths', 'imageUrls', 'evidenceImagePath',
        'evidenceImagePaths', 'evidenceImageUrl', 'evidenceImageUrls'
      ];
      return publicReport.keys().hasOnly(fields)
        && !report.diff(publicReport).affectedKeys().hasAny(fields)
        && publicReport.updatedAt == request.time;
    }

    function isCommunityReport(reportId) {
      return isCitizen() && exists(publicReportPath(reportId));
    }

    function publicReportImage(reportId, imageId) {
      let report = stored(publicReportPath(reportId));
      let path = mediaPath(reportId, imageId);
      return isCitizen() && (path in report.get('imagePaths', [])
        || path in report.get('evidenceImagePaths', [])
        || path == report.get('evidenceImagePath', null));
    }

    function validProfileContact(profile) {
      let phone = profile.get('phoneNumber', null);
      return profile.name is string && profile.name.size() > 0 && profile.name.size() <= 100
        && (phone == null || (phone is string && phone.size() <= 30))
        && profile.updatedAt == request.time;
    }

    function validCitizenProfileUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let profile = request.resource.data;
      return changed.hasOnly(['name', 'phoneNumber', 'updatedAt', 'avatarPath'])
        && validProfileContact(profile)
        && (!changed.hasAny(['avatarPath']) || (
          profile.avatarPath == 'users/' + uid + '/media/avatar'
          && getAfter(/databases/$(database)/documents/users/$(uid)/media/avatar).data.updatedAt == request.time
        ));
    }

    function validAdminProfileUpdate(uid) {
      let profile = request.resource.data;
      let changed = profile.diff(resource.data).affectedKeys();
      return isAdmin() && request.auth.uid == uid
        && changed.hasOnly(['name', 'phoneNumber', 'email', 'updatedAt'])
        && validProfileContact(profile)
        && (!changed.hasAny(['email']) || (
          request.auth.token.get('email_verified', false) == true
          && profile.email is string
          && profile.email == request.auth.token.email
        ));
    }

    function validImage(maxBytes) {
      let image = request.resource.data;
      return image.keys().hasOnly(['data', 'contentType', 'updatedAt'])
        && image.data is bytes && image.data.size() > 0 && image.data.size() <= maxBytes
        && image.contentType == 'image/jpeg'
        && image.updatedAt == request.time;
    }

    function mediaPath(reportId, imageId) {
      return 'reports/' + reportId + '/media/' + imageId;
    }

    function photoIncluded(reportId, photos, index, imageId) {
      return photos.size() <= index
        || (photos[index] == mediaPath(reportId, imageId)
          && getAfter(/databases/$(database)/documents/reports/$(reportId)/media/$(imageId)).data.updatedAt == request.time);
    }

    function textField(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max
        && value.matches('(?s).*\\S.*');
    }

    function validReportLocation(report) {
      let location = report.location;
      return report.latitude is number && report.latitude >= -7.2350 && report.latitude <= -7.0900
        && report.longitude is number && report.longitude >= -78.5750 && report.longitude <= -78.4300
        && textField(report.address, 1, 500)
        && location is map && location.keys().hasOnly(['latitude', 'longitude', 'address', 'reference'])
        && location.latitude == report.latitude && location.longitude == report.longitude
        && location.address == report.address
        && location.get('reference', null) == report.get('reference', null)
        && (report.get('reference', null) == null || textField(report.reference, 1, 500));
    }

    function historyWritten(reportId, before, after) {
      let eventId = after.get('statusEventId', '');
      return eventId is string && eventId.matches('[a-f0-9-]{36}')
        && eventId != before.get('statusEventId', '')
        && getAfter(/databases/$(database)/documents/reports/$(reportId)/history/$(eventId)).data.timestamp == request.time;
    }

    function validReportPhotoCreation(reportId) {
      let report = request.resource.data;
      let photos = report.get('imagePaths', []);
      return request.auth != null && citizenOwnsDocument(request.auth.uid)
        && report.id == reportId && report.citizenId == request.auth.uid
        && report.status == 'pending' && report.updatedAt == request.time && report.createdAt == request.time
        && report.keys().hasOnly([
          'id', 'reportNumber', 'citizenId', 'citizenName', 'citizenPhone',
          'categoryId', 'categoryName', 'categoryIcon', 'description', 'priority', 'status',
          'latitude', 'longitude', 'address', 'reference', 'location', 'createdAt', 'updatedAt',
          'imagePaths', 'statusEventId'
        ])
        && textField(report.reportNumber, 1, 100)
        && textField(report.citizenName, 1, 100)
        && (report.get('citizenPhone', null) == null || textField(report.citizenPhone, 1, 30))
        && textField(report.categoryId, 1, 100)
        && textField(report.categoryName, 1, 100)
        && textField(report.categoryIcon, 1, 100)
        && textField(report.description, 5, 300)
        && validReportLocation(report)
        && report.priority in ['low', 'medium', 'high']
        && photos is list && photos.size() >= 1 && photos.size() <= 4
        && photoIncluded(reportId, photos, 0, 'photo_0')
        && photoIncluded(reportId, photos, 1, 'photo_1')
        && photoIncluded(reportId, photos, 2, 'photo_2')
        && photoIncluded(reportId, photos, 3, 'photo_3')
        && historyWritten(reportId, {}, report);
    }

    function canResolveWithEvidence(reportId) {
      let before = get(/databases/$(database)/documents/reports/$(reportId)).data;
      let after = getAfter(/databases/$(database)/documents/reports/$(reportId)).data;
      let teamId = before.get('assignedToTeamId', null);
      return isStaff() && (teamId in [null, '']
          ? before.get('assignedStaffId', null) == request.auth.uid
          : isCrewLeader(teamId))
        && status(before.status) == 'in_progress'
        && after.status == 'resolved' && after.assignedStaffId == request.auth.uid
        && after.resolvedAt == request.time
        && after.updatedAt == request.time && after.evidenceImagePath == mediaPath(reportId, 'evidence')
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'assignedStaffId', 'assignedStaffName', 'resolutionNotes', 'updatedAt',
          'evidenceImagePath', 'evidenceImagePaths', 'statusEventId', 'resolvedAt'
        ]);
    }

    function validResolutionPhotos(reportId, report) {
      let photos = report.get('evidenceImagePaths', [report.evidenceImagePath]);
      return photos is list && photos.size() >= 1 && photos.size() <= 4
        && photoIncluded(reportId, photos, 0, 'evidence')
        && photoIncluded(reportId, photos, 1, 'evidence_1')
        && photoIncluded(reportId, photos, 2, 'evidence_2')
        && photoIncluded(reportId, photos, 3, 'evidence_3');
    }

    function canWriteEvidence(reportId, imageId) {
      let after = getAfter(/databases/$(database)/documents/reports/$(reportId)).data;
      return imageId.matches('evidence(_[1-3])?') && canResolveWithEvidence(reportId)
        && mediaPath(reportId, imageId) in after.get('evidenceImagePaths', [after.evidenceImagePath]);
    }

    function receivesNotices(uid) {
      let settings = stored(/databases/$(database)/documents/users/$(uid)/settings/notifications);
      return activeRole(uid, ['citizen', 'ciudadano']) && settings.get('reportUpdates', true);
    }

    function noticeFieldsMatch(notice, reportId, report) {
      let number = report.get('reportNumber', null);
      return notice.keys().hasOnly(['reportId', 'reportNumber', 'status', 'createdAt', 'readAt', 'pushPending'])
        && notice.reportId == reportId && notice.reportNumber == (number == null ? reportId : number)
        && notice.status == report.status && notice.createdAt == request.time
        && notice.readAt == null && notice.pushPending == true;
    }

    function statusChanged(before, after) {
      return status(before.status) != after.status
        && after.status in ['assigned', 'in_progress', 'resolved'];
    }

    function validNoticeForChange(reportId, before, after) {
      let uid = before.citizenId;
      let eventId = after.get('statusEventId', '');
      return !statusChanged(before, after) || (
        eventId is string && eventId.matches('[a-f0-9-]{36}')
        && eventId != before.get('statusEventId', '')
        && (receivesNotices(uid)
          ? noticeFieldsMatch(afterWrite(/databases/$(database)/documents/users/$(uid)/notifications/$(eventId)), reportId, after)
          : !existsAfter(/databases/$(database)/documents/users/$(uid)/notifications/$(eventId)))
      );
    }

    function validReportNotice(uid, eventId) {
      let notice = request.resource.data;
      let reportId = notice.reportId;
      let before = stored(/databases/$(database)/documents/reports/$(reportId));
      let after = afterWrite(/databases/$(database)/documents/reports/$(reportId));
      return (isAdmin() || isStaff()) && receivesNotices(uid)
        && before.citizenId == uid && after.citizenId == uid
        && statusChanged(before, after) && after.statusEventId == eventId
        && after.updatedAt == request.time && noticeFieldsMatch(notice, reportId, after);
    }

    function openCrew(report) {
      return status(report.get('status', 'none')) in ['assigned', 'in_progress']
        ? report.get('assignedToTeamId', null) : null;
    }

    function crewReportRecorded(crewId, reportId, eventId) {
      let activity = getAfter(/databases/$(database)/documents/crews/$(crewId)).data.reportActivity;
      return activity.reportId == reportId && activity.eventId == eventId;
    }

    function crewReportsRecorded(reportId, before, after) {
      let oldCrew = openCrew(before);
      let nextCrew = openCrew(after);
      return oldCrew == nextCrew || (
        (oldCrew in [null, ''] || crewReportRecorded(oldCrew, reportId, after.statusEventId))
        && (nextCrew in [null, ''] || crewReportRecorded(nextCrew, reportId, after.statusEventId))
      );
    }

    function validCrewReportCounter(crewId) {
      let next = request.resource.data;
      let activity = next.reportActivity;
      let path = reportPath(activity.reportId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let oldCrew = openCrew(before);
      let nextCrew = openCrew(after);
      let addsReport = nextCrew == crewId;
      return next.diff(resource.data).affectedKeys().hasOnly([
          'openReportCount', 'reportActivity', 'status', 'updatedAt'
        ])
        && after.statusEventId == activity.eventId && after.updatedAt == request.time
        && after.statusEventId != before.get('statusEventId', '')
        && oldCrew != nextCrew && crewId in [oldCrew, nextCrew]
        && next.openReportCount is int && next.openReportCount >= 0
        && next.openReportCount == resource.data.openReportCount + (addsReport ? 1 : -1)
        && validCrewReportStatus(resource.data, next, addsReport);
    }

    function validCrewReportStatus(before, after, addsReport) {
      let previous = before.get('status', null);
      let next = after.get('status', null);
      return addsReport
        ? next == 'onRoute' && after.updatedAt == request.time
        : (previous in ['onRoute', 'on_route'] && after.openReportCount == 0
          ? next == 'available' && after.updatedAt == request.time
          : next == previous && before.get('updatedAt', null) == after.get('updatedAt', null));
    }

    function activeTaskPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/operations/activeTask;
    }

    function activeTaskOwner(before, after) {
      let teamId = before.get('assignedToTeamId', null);
      let previousAssignee = before.get('assignedStaffId', null);
      return after.status == 'resolved' && !(teamId in [null, '']) && previousAssignee is string
        && previousAssignee.size() > 0
        ? previousAssignee
        : request.auth.uid;
    }

    function activeTaskRecorded(reportId, before, after) {
      let active = getAfter(activeTaskPath(activeTaskOwner(before, after))).data;
      return active.reportId == reportId && active.eventId == after.statusEventId
        && active.updatedAt == request.time;
    }

    function validActiveTaskUpdate(uid) {
      let active = request.resource.data;
      let previousIds = stored(activeTaskPath(uid)).get('reportIds', []);
      let path = reportPath(active.reportId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let teamId = before.get('assignedToTeamId', null);
      return isStaff() && uid == activeTaskOwner(before, after)
        && active.keys().hasOnly(['reportIds', 'reportId', 'eventId', 'updatedAt'])
        && active.updatedAt == request.time && after.updatedAt == request.time
        && active.eventId == after.statusEventId && active.eventId != before.get('statusEventId', '')
        && after.assignedStaffId == request.auth.uid && (
          (status(before.status) == 'assigned' && after.status == 'in_progress'
            && previousIds.size() == 0 && active.reportIds == [active.reportId])
          || (status(before.status) == 'in_progress' && after.status == 'resolved'
            && (teamId in [null, ''] ? active.reportId in previousIds : isCrewLeader(teamId))
            && active.reportIds == previousIds.removeAll([active.reportId]))
        );
    }

    function validHistoryCreate(reportId, eventId) {
      let before = stored(reportPath(reportId));
      let after = getAfter(reportPath(reportId)).data;
      let history = request.resource.data;
      let nextStatus = after.status;
      return request.auth != null && after.updatedAt == request.time
        && after.statusEventId == eventId && before.get('statusEventId', '') != eventId
        && history.keys().hasOnly([
          'previousStatus', 'newStatus', 'changedByUserId', 'changedByUserName',
          'changedByUserRole', 'comment', 'timestamp'
        ])
        && history.timestamp == request.time && history.changedByUserId == request.auth.uid
        && history.changedByUserName is string && history.comment is string
        && history.previousStatus == status(before.get('status', 'none')) && history.newStatus == nextStatus
        && publicReportMatches(after, getAfter(publicReportPath(reportId)).data)
        && (
          (nextStatus in ['pending', 'cancelled'] && history.changedByUserRole == 'citizen'
            && after.citizenId == request.auth.uid)
          || (nextStatus == 'assigned' && history.changedByUserRole == 'admin'
            && crewReportsRecorded(reportId, before, after))
          || (nextStatus in ['in_progress', 'resolved'] && history.changedByUserRole == 'staff'
            && activeTaskRecorded(reportId, before, after) && crewReportsRecorded(reportId, before, after))
        )
        && (before.size() == 0 || validNoticeForChange(reportId, before, after));
    }

    function validDispatch(report) {
      let teamId = report.get('assignedToTeamId', null);
      let assignees = report.get('assignedStaffIds', []);
      return assignees is list && assignees.toSet().size() == assignees.size() && (
        (teamId == null && assignees.size() > 0 && report.get('assignedVehicle', null) == null)
        || (assignees.size() == 0 && crewExists(teamId) && dispatchableCrew(teamId))
      );
    }

    function dispatchableCrew(teamId) {
      let team = get(/databases/$(database)/documents/crews/$(teamId)).data;
      let leader = crewLeaderId(team);
      let truckId = team.get('vehicleId', null);
      return team.get('vehicleOnly', false) == false
        && leader is string && leader in team.get('memberIds', [leader])
        && managedMember(teamId, leader)
        && (truckId == null || dispatchableTruck(truckId, teamId))
        && (!team.keys().hasAny(['memberIds'])
          || (team.openReportCount == 0 && team.get('status', 'available') == 'available'
            && team.get('isAvailable', true)));
    }

    function dispatchableTruck(truckId, teamId) {
      let truck = afterWrite(/databases/$(database)/documents/vehicles/$(truckId));
      return truck.get('assignedCrewId', null) == teamId
        && truck.get('status', null) == 'available' && truck.get('isAvailable', true);
    }

    function validDispatchReservation(uid) {
      let reservation = request.resource.data;
      let report = getAfter(reportPath(reservation.reportId)).data;
      let oldReportId = resource == null ? reservation.reportId : resource.data.reportId;
      let previous = stored(reportPath(oldReportId));
      return isAdmin() && activeRole(uid, ['staff', 'personal'])
        && stored(/databases/$(database)/documents/users/$(uid)).get('teamId', null) in [null, '']
        && reservation.keys().hasOnly(['reportId', 'updatedAt'])
        && reservation.updatedAt == request.time
        && report.updatedAt == request.time && report.status == 'assigned'
        && uid in report.get('assignedStaffIds', [])
        && (oldReportId == reservation.reportId
          || !(status(previous.get('status', 'none')) in ['assigned', 'in_progress'])
          || !(uid in previous.get('assignedStaffIds', [])));
    }

    function validReportUpdate(reportId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return request.auth != null && after.updatedAt == request.time && (
        (changed.hasOnly(['priority', 'updatedAt']) && after.priority in ['low', 'medium', 'high']
          && isAdmin() && publicReportMatches(after, getAfter(publicReportPath(reportId)).data))
        || (historyWritten(reportId, before, after) && (
          (isAdmin() && status(before.status) in ['pending', 'assigned'] && after.status == 'assigned'
            && after.priority in ['low', 'medium', 'high']
            && validDispatch(after)
            && after.get('assignedStaffId', null) == null
            && changed.hasOnly([
              'status', 'assignedToTeamId', 'assignedToTeamName', 'assignedStaffName',
              'assignedStaffId', 'assignedStaffIds', 'assignedVehicle', 'priority', 'updatedAt', 'statusEventId'
            ]))
          || (isStaff() && after.status == 'in_progress' && status(before.status) == 'assigned'
            && canStartReport(before)
            && after.assignedStaffId == request.auth.uid
            && changed.hasOnly(['status', 'assignedStaffId', 'assignedStaffName', 'updatedAt', 'statusEventId']))
          || (after.status == 'resolved' && canResolveWithEvidence(reportId)
            && validResolutionPhotos(reportId, after))
          || (citizenOwnsDocument(before.citizenId) && status(before.status) == 'pending'
            && after.status == 'cancelled' && after.cancellationReason is string
            && changed.hasOnly(['status', 'cancellationReason', 'updatedAt', 'statusEventId']))
        ))
      );
    }

    function validCommunityChange(reportId, uid) {
      let report = stored(/databases/$(database)/documents/reports/$(reportId));
      let before = stored(/databases/$(database)/documents/reports/$(reportId)/participants/$(uid));
      let after = afterWrite(/databases/$(database)/documents/reports/$(reportId)/participants/$(uid));
      let oldSummary = stored(/databases/$(database)/documents/reports/$(reportId)/community/summary);
      let summary = afterWrite(/databases/$(database)/documents/reports/$(reportId)/community/summary);
      let wasSupported = before.get('supported', false);
      let supported = after.get('supported', false);
      let oldRating = before.get('rating', 0);
      let rating = after.get('rating', 0);
      return citizenOwnsDocument(uid)
        && after.keys().hasOnly(['supported', 'rating']) && supported is bool && rating is int
        && (!after.keys().hasAny(['rating']) || (rating >= 1 && rating <= 5))
        && summary.keys().hasOnly(['supportCount', 'ratingCount', 'ratingTotal'])
        && summary.get('supportCount', 0) == oldSummary.get('supportCount', 0) + (supported && !wasSupported ? 1 : 0)
        && summary.get('ratingCount', 0) == oldSummary.get('ratingCount', 0) + (rating != oldRating ? 1 : 0)
        && summary.get('ratingTotal', 0) == oldSummary.get('ratingTotal', 0) + (rating - oldRating)
        && (
          (status(report.status) in ['pending', 'assigned', 'in_progress']
            && report.citizenId != uid && !wasSupported && supported && oldRating == rating)
          || (status(report.status) == 'resolved' && (report.citizenId == uid || wasSupported)
            && supported == wasSupported && oldRating == 0 && rating >= 1 && rating <= 5)
        );
    }

    function ownsStaffProfile(uid) {
      return isStaff() && request.auth.uid == uid;
    }

    function shiftPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/operations/shift;
    }

    function validShiftUpdate(uid) {
      let before = stored(shiftPath(uid));
      let next = request.resource.data;
      let previousStatus = before.get('status', 'off_duty');
      let event = afterWrite(/databases/$(database)/documents/users/$(uid)/shiftEvents/$(next.eventId));
      return ownsStaffProfile(uid)
        && next.keys().hasOnly(['status', 'sessionId', 'eventId', 'changedAt'])
        && next.eventId.matches('[a-zA-Z0-9]{20}') && next.changedAt == request.time
        && (previousStatus == 'off_duty'
          ? next.status == 'on_duty' && next.sessionId == next.eventId
          : next.status in ['on_duty', 'on_break', 'off_duty'] && next.status != previousStatus
            && next.sessionId == before.sessionId)
        && event.status == next.status && event.changedAt == request.time
        && event.sessionId == next.sessionId;
    }

    function crewMemberRecorded(crewId, uid) {
      let activity = getAfter(/databases/$(database)/documents/crews/$(crewId)).data.memberActivity;
      return activity.userId == uid && activity.updatedAt == request.time;
    }

    function teamMemberAdded(teamId, uid) {
      let path = /databases/$(database)/documents/crews/$(teamId);
      let team = getAfter(path).data;
      return team.get('vehicleOnly', false) == false && (
        team.keys().hasAny(['memberIds'])
          ? uid in team.memberIds
          : crewMemberRecorded(teamId, uid)
      );
    }

    function teamMemberRemoved(teamId, uid) {
      let path = /databases/$(database)/documents/crews/$(teamId);
      let before = get(path).data;
      let after = afterWrite(path);
      return before.keys().hasAny(['memberIds']) || after.keys().hasAny(['memberIds'])
        ? before.openReportCount == 0 && !(uid in after.get('memberIds', []))
        : after.get('leaderId', null) != uid && crewMemberRecorded(teamId, uid);
    }

    function crewMembersRecorded(uid, before, after) {
      let oldCrew = before.get('teamId', null);
      let nextCrew = after.get('teamId', null);
      return oldCrew == nextCrew || (
        (oldCrew in [null, ''] || teamMemberRemoved(oldCrew, uid))
        && (nextCrew == null || (oldCrew in [null, ''] && teamMemberAdded(nextCrew, uid))
          || (!getAfter(/databases/$(database)/documents/crews/$(nextCrew)).data.keys().hasAny(['memberIds'])
            && crewMemberRecorded(nextCrew, uid)))
      );
    }

    function validRoster(team) {
      let ids = team.memberIds;
      return team.get('vehicleOnly', false) == false && ids is list
        && ids.size() >= 2 && ids.size() <= 5 && ids.toSet().size() == ids.size()
        && team.memberCount == ids.size() && team.crewMembersCount == ids.size();
    }

    function existingMember(teamId, uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.teamId == teamId;
    }

    function recordsLegacyRoster(teamId, before, after) {
      let ids = after.memberIds;
      return before.get('vehicleOnly', false) == false
        && !before.keys().hasAny(['memberIds']) && before.openReportCount == 0
        && after.diff(before).affectedKeys().hasOnly(['memberIds', 'crewMembersCount'])
        && ids is list && ids.size() >= 1 && ids.size() <= 5
        && ids.toSet().size() == ids.size()
        && before.memberCount == ids.size() && after.crewMembersCount == ids.size()
        && existingMember(teamId, ids[0])
        && (ids.size() < 2 || existingMember(teamId, ids[1]))
        && (ids.size() < 3 || existingMember(teamId, ids[2]))
        && (ids.size() < 4 || existingMember(teamId, ids[3]))
        && (ids.size() < 5 || existingMember(teamId, ids[4]));
    }

    function managedMembers(teamId, ids) {
      return managedMember(teamId, ids[0]) && managedMember(teamId, ids[1])
        && (ids.size() < 3 || managedMember(teamId, ids[2]))
        && (ids.size() < 4 || managedMember(teamId, ids[3]))
        && (ids.size() < 5 || managedMember(teamId, ids[4]));
    }

    function managedMember(teamId, uid) {
      let profile = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return profile.get('teamId', null) == teamId
        && profile.role in ['staff', 'personal'] && profile.get('isActive', true);
    }

    function validCrewLeadership(teamId, team) {
      let leader = team.get('leaderId', null);
      return leader is string && leader.size() > 0
        && leader in team.get('memberIds', [leader])
        && managedMember(teamId, leader);
    }

    function validCrewLeadershipUpdate(teamId, before, after) {
      let changes = after.diff(before).affectedKeys();
      return !changes.hasAny(['leaderId', 'memberIds'])
        || (after.get('leaderId', null) == null
          ? !before.keys().hasAny(['leaderId'])
            && recordsLegacyRoster(teamId, before, after)
          : validCrewLeadership(teamId, after));
    }

    function validCrewMemberCounter(crewId) {
      let next = request.resource.data;
      let activity = next.memberActivity;
      let path = /databases/$(database)/documents/users/$(activity.userId);
      let oldCrew = get(path).data.get('teamId', null);
      let profile = getAfter(path).data;
      let nextCrew = profile.get('teamId', null);
      return next.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberActivity'])
        && activity.updatedAt == request.time && profile.updatedAt == request.time
        && oldCrew != nextCrew && crewId in [oldCrew, nextCrew]
        && next.memberCount is int && next.memberCount >= 0
        && next.memberCount == resource.data.memberCount + (nextCrew == crewId ? 1 : -1);
    }

    function validTruckLink(teamId, team) {
      let id = team.get('vehicleId', null);
      return id is string && id.size() > 0
        && getAfter(/databases/$(database)/documents/vehicles/$(id)).data.assignedCrewId == teamId;
    }

    function previousTruckReleased(teamId, before) {
      let id = before.get('vehicleId', null);
      return id == null
        || afterWrite(/databases/$(database)/documents/vehicles/$(id)).get('assignedCrewId', null) != teamId;
    }

    function validTruckOwner(truckId, before, after) {
      let oldTeam = before.get('assignedCrewId', null);
      let newTeam = after.get('assignedCrewId', null);
      return oldTeam == newTeam || (
        (oldTeam == null
          || afterWrite(/databases/$(database)/documents/crews/$(oldTeam)).get('vehicleId', null) != truckId)
        && (newTeam == null || (oldTeam == null && before.status == 'available'
          && before.get('isAvailable', true)
          && getAfter(/databases/$(database)/documents/crews/$(newTeam)).data.vehicleId == truckId)));
    }

    function validTruckMaintenance(before, after) {
      let teamId = before.get('assignedCrewId', null);
      return after.get('status', null) != 'maintenance'
        || before.get('status', null) == 'maintenance'
        || teamId == null
        || afterWrite(/databases/$(database)/documents/crews/$(teamId)).get('openReportCount', 0) == 0;
    }

    function removedMemberWasReleased(teamId, ids, uid) {
      return uid in ids || releasedMember(teamId, uid);
    }

    function removedMembersWereReleased(teamId, before, after) {
      let next = after.memberIds;
      let ids = before.get('memberIds', []);
      return (ids.size() < 1 || removedMemberWasReleased(teamId, next, ids[0]))
        && (ids.size() < 2 || removedMemberWasReleased(teamId, next, ids[1]))
        && (ids.size() < 3 || removedMemberWasReleased(teamId, next, ids[2]))
        && (ids.size() < 4 || removedMemberWasReleased(teamId, next, ids[3]))
        && (ids.size() < 5 || removedMemberWasReleased(teamId, next, ids[4]));
    }

    function releasedMember(teamId, uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.get('teamId', null) != teamId;
    }

    function releasedMembers(teamId, ids) {
      return ids.size() <= 5
        && (ids.size() < 1 || releasedMember(teamId, ids[0]))
        && (ids.size() < 2 || releasedMember(teamId, ids[1]))
        && (ids.size() < 3 || releasedMember(teamId, ids[2]))
        && (ids.size() < 4 || releasedMember(teamId, ids[3]))
        && (ids.size() < 5 || releasedMember(teamId, ids[4]));
    }

    match /users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.id == uid && request.resource.data.role == 'citizen'
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.get('teamId', null) == null
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'email', 'role', 'phoneNumber', 'photoUrl', 'teamId',
          'isActive', 'createdAt', 'updatedAt'
        ]);
      allow update: if citizenOwnsDocument(uid) && validCitizenProfileUpdate(uid);
      allow update: if validAdminProfileUpdate(uid);
      allow update: if isAdmin() && resource.data.role in ['citizen', 'ciudadano', 'staff', 'personal']
        && request.resource.data.role in ['citizen', 'staff', 'personal']
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.get('teamId', null) == null
          || (resource.data.get('teamId', null) == '' && request.resource.data.get('teamId', null) == '')
          || (request.resource.data.role in ['staff', 'personal'] && crewExists(request.resource.data.teamId)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'teamId', 'updatedAt'])
        && crewMembersRecorded(uid, resource.data, request.resource.data);

      match /operations/dispatch {
        allow get: if isAdmin();
        allow create, update: if validDispatchReservation(uid);
      }

      match /operations/activeTask {
        allow get: if ownsStaffProfile(uid) || isAdmin();
        allow create, update: if validActiveTaskUpdate(uid);
      }

      match /operations/shift {
        allow get: if ownsStaffProfile(uid) || isAdmin();
        allow create, update: if validShiftUpdate(uid);
      }

      match /shiftEvents/{eventId} {
        allow read: if ownsStaffProfile(uid);
        allow create: if ownsStaffProfile(uid)
          && request.resource.data.keys().hasOnly(['status', 'sessionId', 'changedAt'])
          && request.resource.data.changedAt == request.time
          && getAfter(shiftPath(uid)).data.changedAt == request.time
          && getAfter(shiftPath(uid)).data.eventId == eventId;
      }

      match /media/avatar {
        allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create, update: if citizenOwnsDocument(uid)
          && validImage(96 * 1024)
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.avatarPath == 'users/' + uid + '/media/avatar'
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.updatedAt == request.time;
      }

      match /settings/notifications {
        allow get: if citizenOwnsDocument(uid);
        allow create, update: if citizenOwnsDocument(uid)
          && request.resource.data.keys().hasOnly(['reportUpdates', 'nearbyTruck', 'campaigns'])
          && request.resource.data.reportUpdates is bool
          && request.resource.data.nearbyTruck is bool
          && request.resource.data.campaigns is bool;
      }

      match /notifications/{notificationId} {
        allow get, list: if citizenOwnsDocument(uid);
        allow create: if validReportNotice(uid, notificationId);
        allow update: if citizenOwnsDocument(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
      }
    }

    match /reports/{reportId} {
      allow get, list: if canReadReport(resource.data);
      allow create: if validReportPhotoCreation(reportId);
      allow update: if validReportUpdate(reportId);

      match /history/{entry} {
        allow get, list: if canReadReportChild(reportId);
        allow create: if validHistoryCreate(reportId, entry);
      }

      match /media/{imageId} {
        allow get: if canReadReportChild(reportId) || publicReportImage(reportId, imageId);
        allow create: if request.auth != null && validImage(256 * 1024) && (
          (imageId.matches('photo_[0-3]') && citizenOwnsDocument(request.auth.uid)
            && !exists(/databases/$(database)/documents/reports/$(reportId))
            && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.citizenId == request.auth.uid
            && mediaPath(reportId, imageId) in getAfter(/databases/$(database)/documents/reports/$(reportId)).data.imagePaths)
          || canWriteEvidence(reportId, imageId)
        );
        allow update: if request.auth != null && validImage(256 * 1024)
          && canWriteEvidence(reportId, imageId);
      }

      match /community/summary {
        allow get: if canReadReportChild(reportId) || isCommunityReport(reportId);
        allow create, update: if request.auth != null && validCommunityChange(reportId, request.auth.uid);
      }

      match /participants/{uid} {
        allow get: if citizenOwnsDocument(uid);
        allow create, update: if request.auth != null && validCommunityChange(reportId, uid);
      }
    }

    match /communityReports/{reportId} {
      allow get, list: if isCitizen() || isAdmin();
      allow create, update: if request.auth != null
        && publicReportMatches(getAfter(reportPath(reportId)).data, request.resource.data);
    }

    match /crews/{crewId} {
      allow read: if isAdmin();
      allow get: if isStaff() && isCrewMember(crewId);
      allow create: if isAdmin() && request.resource.data.openReportCount == 0
        && request.resource.data.get('vehicleOnly', false) == false
        && !request.resource.data.keys().hasAny(['reportActivity', 'memberActivity', 'assignedCrewId'])
        && validRoster(request.resource.data) && managedMembers(crewId, request.resource.data.memberIds)
        && validCrewLeadership(crewId, request.resource.data)
        && request.resource.data.get('vehicleId', null) != null
        && validTruckLink(crewId, request.resource.data);
      allow update: if (isAdmin() && (
        resource.data.get('vehicleOnly', false) == false &&
        (request.resource.data.keys().hasAny(['memberIds'])
          ? (request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['memberIds', 'memberCount', 'crewMembersCount'])
            ? recordsLegacyRoster(crewId, resource.data, request.resource.data)
              || (resource.data.openReportCount == 0 && validRoster(request.resource.data)
                && managedMembers(crewId, request.resource.data.memberIds)
                && removedMembersWereReleased(crewId, resource.data, request.resource.data))
            : true)
          : !resource.data.keys().hasAny(['memberIds'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount', 'memberActivity'])
              || validCrewMemberCounter(crewId)))
        && validCrewLeadershipUpdate(crewId, resource.data, request.resource.data)
        && (resource.data.get('vehicleId', null) == request.resource.data.get('vehicleId', null)
          || (resource.data.openReportCount == 0
            && validTruckLink(crewId, request.resource.data)
            && previousTruckReleased(crewId, resource.data)))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'openReportCount', 'reportActivity', 'vehicleOnly', 'assignedCrewId'
        ])
      )) || ((isAdmin() || isStaff()) && validCrewReportCounter(crewId));
      allow delete: if isAdmin() && resource.data.openReportCount == 0
        && resource.data.get('vehicleOnly', false) == false
        && resource.data.get('assignedCrewId', null) == null
        && previousTruckReleased(crewId, resource.data)
        && (resource.data.keys().hasAny(['memberIds'])
          ? releasedMembers(crewId, resource.data.memberIds)
          : resource.data.memberCount == 0);

    }

    match /vehicles/{vehicleId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.get('assignedCrewId', null) == null;
      allow update: if isAdmin()
        && validTruckOwner(vehicleId, resource.data, request.resource.data)
        && validTruckMaintenance(resource.data, request.resource.data);
      allow delete: if isAdmin() && resource.data.get('assignedCrewId', null) == null;
    }

    match /report_categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /citizenPushDevices/{token} {
      allow create, update: if request.auth != null && citizenOwnsDocument(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && token.size() >= 20 && token.size() <= 1024
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
